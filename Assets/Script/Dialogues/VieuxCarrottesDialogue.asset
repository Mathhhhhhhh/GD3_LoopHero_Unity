  m_Script: {fileID: 11500000, guid: a01ece32ade69d54a83a6f4487a5ee96, type: 3}
  m_Name: VieuxCarrottesDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDatas
  rows:
  - rowNumber: 0
    characterName: Lulu
    longDialogue: "Vieux ! Je les ai retrouv\xE9es, vos 3 carottes ! Quelqu'un les
      avait cach\xE9es dans un champ au bout du chemin."
    nextRowNumber: 1
  - rowNumber: 1
    characterName: Vieux
    longDialogue: "Mes carottes ! Tu les as vraiment trouv\xE9es... Je n'en crois
      pas mes yeux. Merci, gamin, merci du fond du coeur !"
    nextRowNumber: 2
  - rowNumber: 2
    characterName: Vieux
    longDialogue: "Tiens, prends \xE7a. C'est tout ce que j'ai \xE0 t'offrir. Tu
      m'as rendu un fier service aujourd'hui."
    nextRowNumber: -1
